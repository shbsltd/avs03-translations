#. Class select - name (brick)
#. source: Brick
msgid "CLASS.brick.name"
msgstr "აგური"

#. Class select - description (brick)
#. source: Add +40 Max HP.\nAdd +12 Armo(u)r.\nMultiply Cursor Speed
#. 0.8x.\nMultiply Weapon Damage 0.85x.\nMultiply Weapon Damage 1.1x when
#. taking Damage (Lasts 8s, stacks up to 3).
msgid "CLASS.brick.description"
msgstr ""
"მაქს. HP +40.\n"
"ჯავშანი +12.\n"
"კურსორის სიჩქარე ×0.8.\n"
"იარაღის ზიანი ×0.85.\n"
"ზიანის მიღებისას იარაღის ზიანი ×1.1 (8 წმ; ჯამდება 3-ჯერ)."

#. Class select - name (default)
#. source: Default
msgid "CLASS.default.name"
msgstr "სტანდარტული"

#. Class select - description (default)
#. source: No class bonuses or penalties.\nBalanced baseline cursor.
msgid "CLASS.default.description"
msgstr ""
"კლასის ბონუსებისა და შეზღუდვების გარეშე.\n"
"დაბალანსებული საწყისი კურსორი."

#. Class select - name (null)
#. source: Null
msgid "CLASS.null.name"
msgstr "ნული"

#. Class select - description (null)
#. source: Reduce Max HP -25.\nAdd +8 Packet Loss.\nMultiply Luck
#. 1.5x.\nMultiply Weapon Damage 0.9x.
msgid "CLASS.null.description"
msgstr ""
"მაქს. HP -25.\n"
"პაკეტების დაკარგვა +8.\n"
"იღბალი ×1.5.\n"
"იარაღის ზიანი ×0.9."

#. Class select - name (vector)
#. source: Vector
msgid "CLASS.vector.name"
msgstr "ვექტორი"

#. Class select - description (vector)
#. source: Multiply Cursor Speed 1.25x.\nAdd +15 Packet Loss.\nReduce Max HP
#. -25.\nMultiply Weapon Damage 0.9x.\nMultiply Cursor Speed 1.25x and Refresh
#. Speed 1.2x on Packet Loss (Lasts 4s).
msgid "CLASS.vector.description"
msgstr ""
"კურსორის სიჩქარე ×1.25.\n"
"პაკეტების დაკარგვა +15.\n"
"მაქს. HP -25.\n"
"იარაღის ზიანი ×0.9.\n"
"პაკეტის დაკარგვისას კურსორის სიჩქარე ×1.25 და განახლების სიჩქარე ×1.2 (4 წმ)."

#. Class select - name (breakpoint)
#. source: Breakpoint
msgid "CLASS.breakpoint.name"
msgstr "შეჩერების წერტილი"

#. Class select - description (breakpoint)
#. source: Increase Crit Chance +12%.\nMultiply Crit Damage 1.25x.\nReduce Max
#. HP -15.\nMultiply Cursor Speed 0.9x.\nMultiply Weapon Damage 0.92x.
msgid "CLASS.breakpoint.description"
msgstr ""
"კრიტ. დარტყმის შანსი +12%.\n"
"კრიტ. ზიანი ×1.25.\n"
"მაქს. HP -15.\n"
"კურსორის სიჩქარე ×0.9.\n"
"იარაღის ზიანი ×0.92."

#. Class select - name (thread)
#. source: Thread
msgid "CLASS.thread.name"
msgstr "ნაკადი"

#. Class select - description (thread)
#. source: Multiply Processing Speed 1.3x.\nMultiply Refresh Speed
#. 1.12x.\nMultiply EXP Gain 1.08x.\nMultiply Weapon Damage 0.85x.
msgid "CLASS.thread.description"
msgstr ""
"დამუშავების სიჩქარე ×1.3.\n"
"განახლების სიჩქარე ×1.12.\n"
"მიღებული EXP ×1.08.\n"
"იარაღის ზიანი ×0.85."

#. Class select - name (admin)
#. source: Admin
msgid "CLASS.admin.name"
msgstr "ადმინი"

#. Class select - description (admin)
#. source: Start with +1 Key.\nMultiply Coin Gain 1.3x.\nMultiply Pickup Range
#. 1.3x.\nDiscount Shop Items +10%.\nMultiply Max HP 0.9x.\nMultiply Weapon
#. Damage 0.85x.
msgid "CLASS.admin.description"
msgstr ""
"იწყებთ +1 გასაღებით.\n"
"მიღებული მონეტები ×1.3.\n"
"შეგროვების რადიუსი ×1.3.\n"
"მაღაზიაში ფასდაკლება +10%.\n"
"მაქს. HP ×0.9.\n"
"იარაღის ზიანი ×0.85."

#. Folder evolution mode - name (chaos)
#. source: Chaos
msgid "EVO.chaos.name"
msgstr "ქაოსი"

#. Folder evolution mode - description (chaos)
#. source: A inconsistent unpredictable mess of difficulty. I couldn't tell
#. you what to expect.
msgid "EVO.chaos.description"
msgstr ""
"არათანაბარი და არაპროგნოზირებადი სირთულე. წინასწარ ვერ გეტყვით, რა გელით."

#. Folder evolution mode - name (linear)
#. source: Linear
msgid "EVO.linear.name"
msgstr "წრფივი"

#. Folder evolution mode - description (linear)
#. source: A consistent linear stream of more enemies being added over time.
msgid "EVO.linear.description"
msgstr "მტრების რაოდენობა დროთა განმავლობაში თანაბრად იზრდება."

#. Folder evolution mode - name (variable)
#. source: Variable
msgid "EVO.variable.name"
msgstr "ცვალებადი"

#. Folder evolution mode - description (variable)
#. source: A varied level of enemies that ramps up and down to give more
