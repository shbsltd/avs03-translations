#. source: One heavy shot at the strongest enemy. Clears show in a killfeed.
msgid "UPGRADE.weapon_sniper.description"
msgstr "WAN HEAVY SHOT AT TEH STRONGEST ENEMY. CLEARS SHOW IN KILLFED."

#. Upgrade card - name (weapon_minesweeper)
#. source: Mines
msgid "UPGRADE.weapon_minesweeper.name"
msgstr "MINEZ"

