#. source: Tosses mines that plant, then explode when an enemy touches them.
msgid "UPGRADE.weapon_minesweeper.description"
msgstr "TOSEZ MINEZ DAT PLANT, DEN SPLODE WHEN AN ENEMY TOUCHEZ THEM."

#. Upgrade card - name (weapon_email)
#. source: Email
msgid "UPGRADE.weapon_email.name"
msgstr "EMAIL"

#. Upgrade card - description (weapon_email)
#. source: Envelopes fly out, bounce off walls, and boomerang home hitting both ways.
msgid "UPGRADE.weapon_email.description"
msgstr "ENVELOPEZ FLY OUT, BOUNCE OFF WALLS, AN BOOMERANG HOME HITTIN BOTH WAYS."

#. Upgrade card - name (weapon_cruiser)
#. source: Internet Cruiser
msgid "UPGRADE.weapon_cruiser.name"
msgstr "INTERNET CRUISR"

